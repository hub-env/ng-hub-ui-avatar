{
	"name": "ng-hub-ui-avatar",
	"description": "A universal avatar component for Angular applications that fetches / generates avatar based on the information you have about the user. Supports initials, Gravatar integration, custom images and styling options. Perfect for user profiles and comment systems.",
	"version": "22.12.1",
	"keywords": [
		"angular",
		"avatar",
		"avatars",
		"badge",
		"gravatar",
		"component",
		"initials",
		"profile",
		"user-profile",
		"user-avatar",
		"profile-picture",
		"angular-component",
		"ng-avatar",
		"user-interface",
		"ui-component"
	],
	"author": "Carlos Morcillo <carlos.morcillo@me.com> (https://www.carlosmorcillo.com)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hub-env/ng-hub-ui-avatar.git"
	},
	"bugs": {
		"url": "https://github.com/hub-env/hub-ui/issues"
	},
	"sideEffects": false,
	"exports": {
		"./styles": "./styles/index.scss",
		"./styles/index.scss": "./styles/index.scss",
		"./styles/mixins/avatar-theme": "./styles/mixins/_avatar-theme.scss"
	},
	"peerDependencies": {
		"@angular/common": ">=18.0.0",
		"@angular/core": ">=18.0.0",
		"ng-hub-ui-ds": ">=22.0.0",
		"ng-hub-ui-utils": ">=22.7.0"
	},
	"peerDependenciesMeta": {
		"ng-hub-ui-ds": {
			"optional": true
		}
	},
	"dependencies": {
		"tslib": "^2.6.3",
		"ts-md5": "^1.3.1"
	},
	"homepage": "https://hubui.dev/en/avatar/overview/"
}
